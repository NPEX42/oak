cflags = -Wall -Iinclude/  -march=native -DOAK_STANDALONE_HOOKS -Ofast
cxxflags = -Wall -Iinclude/  -march=native -DOAK_STANDALONE_HOOKS $
    -DOAK_PROFILE_DRAW_SYNC -Ofast
ldflags = -L./libs -lglfw3 -lm
rule cc
  command = gcc $cflags -c $in -o $out
rule cxx
  command = g++ $cxxflags -c $in -o $out
rule link
  command = g++ $in -o $out $ldflags
rule ar
  command = ar rcs $out $in
build obj/glad.c.o: cc src/glad.c
build obj/shader.cpp.o: cxx src/shader.cpp
build obj/renderer2d.cpp.o: cxx src/renderer2d.cpp
build obj/oak.cpp.o: cxx src/oak.cpp
build obj/arena.cpp.o: cxx src/arena.cpp
build obj/timer.cpp.o: cxx src/timer.cpp
build obj/utils.cpp.o: cxx src/utils.cpp
build bin/oak: link obj/glad.c.o obj/shader.cpp.o obj/renderer2d.cpp.o $
    obj/oak.cpp.o obj/arena.cpp.o obj/timer.cpp.o obj/utils.cpp.o
build bin/liboak.a: ar obj/glad.c.o obj/shader.cpp.o obj/renderer2d.cpp.o $
    obj/oak.cpp.o obj/arena.cpp.o obj/timer.cpp.o obj/utils.cpp.o
